<Project Sdk="Microsoft.NET.Sdk">

  <!-- Development only (#426): the process an MCP client launches in place of the server, so a new
       server build can be swapped in under running sessions. Never packed and not part of the tool
       package; see docs/development/DEV_HOST.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <RootNamespace>RoslynMcp.DevHost</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
