<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- .NET 10 is the minimum runtime (GA LTS); net11.0 auto-added below when its SDK is present -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>RoslynMcp</AssemblyName>
    <LangVersion>preview</LangVersion>

    <!-- Package metadata -->
    <Authors>Quinten Martens</Authors>
    <Description>Model Context Protocol server exposing Roslyn-powered code intelligence tools to AI coding agents</Description>
    <PackageProjectUrl>https://github.com/MadQ/RoslynMcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MadQ/RoslynMcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>roslyn;mcp;model-context-protocol;csharp;dotnet;ai;llm;ai-agents;code-intelligence;code-analysis;static-analysis;refactoring;developer-tools;copilot;claude</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>v0.8.1-beta — Establishes the permanent MadQ.RoslynMcp identity (package id, madq-roslynmcp command, and MadQ.RoslynMcp MCP server key) to avoid collision with the unrelated RoslynMcp package. Adds identity-safe agent-config detection and hook-entry dedupe. Published via NuGet Trusted Publishing (OIDC). Full notes: https://github.com/MadQ/RoslynMcp/releases/tag/v0.8.1-beta</PackageReleaseNotes>

    <!-- Self-contained so dnx / copilot can run it without a matching SDK on PATH -->
    <PublishSingleFile>true</PublishSingleFile>
    <ProduceReferenceAssembly>False</ProduceReferenceAssembly>
  </PropertyGroup>

  <!-- dotnet tool packaging — only active when building with -c Pack -->
  <PropertyGroup Condition="'$(Configuration)' == 'Pack'">
    <PackAsTool>true</PackAsTool>
    <!-- PackageId and ToolCommandName are namespaced under MadQ to avoid a hard collision
         with the unrelated `RoslynMcp` package (chrismo80) already published on NuGet. -->
    <ToolCommandName>madq-roslynmcp</ToolCommandName>
    <PackageId>MadQ.RoslynMcp</PackageId>
    <PackageReadmeFile>NUGET.md</PackageReadmeFile>
    <!-- Tool assemblies must be loose on disk — BuildHost requires it -->
    <PublishSingleFile>false</PublishSingleFile>
  </PropertyGroup>

  <!-- Detect if .NET 11 SDK is available and add it to TargetFrameworks -->
  <Target Name="DetectNet11SDK" BeforeTargets="BeforeBuild;BeforeRebuild;Restore">
    <PropertyGroup>
      <!-- Try to resolve if net11.0 is supported by checking NETCoreSdkVersion -->
      <_Net11Available Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">true</_Net11Available>
      <TargetFrameworks Condition="'$(_Net11Available)' == 'true'">net10.0;net11.0</TargetFrameworks>
    </PropertyGroup>
    <Message Importance="high" Text="Building for: $(TargetFrameworks)" />
  </Target>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0|AnyCPU'">
    <NoWarn>1701;1702;NETSDK1209</NoWarn>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net11.0|AnyCPU'">
    <NoWarn>1701;1702;NETSDK1209</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0|AnyCPU'">
    <NoWarn>1701;1702;NETSDK1209</NoWarn>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0|AnyCPU'">
    <NoWarn>1701;1702;NETSDK1209</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\NUGET.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude the TestHarness sub-project from the SDK glob — it has its own csproj. -->
    <Compile Remove="TestHarness/**" />
    <None Remove="TestHarness/**" />
    <EmbeddedResource Remove="TestHarness/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.2.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- Explicit reference required by MSBL001: Build.Locator 1.11.2 requires all transitive
         Microsoft.Build.* packages to opt out of runtime assets to prevent assembly-load conflicts. -->
    <PackageReference Include="Microsoft.Build.Framework" Version="18.4.0" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoslynMcp.Analyzers\RoslynMcp.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!--
    Roslyn's MSBuildWorkspace spawns a separate BuildHost process and resolves its path on disk at
    runtime via BuildHostProcessManager. When PublishSingleFile=true the SDK bundles all referenced
    assemblies into the host executable — including the BuildHost DLLs — leaving the BuildHost-*
    directories with only the .deps.json / .runtimeconfig.json files. The process launch then fails
    with "The build host could not be found at '...BuildHost-netcore\...BuildHost.dll'".

    Fix: exclude every file under BuildHost-netcore/ and BuildHost-net472/ from single-file bundling
    so they remain as loose files on disk next to the executable.
  -->
  <Target Name="ExcludeBuildHostFromSingleFile" BeforeTargets="_ComputeFilesToBundle">
    <ItemGroup>
      <ResolvedFileToPublish Condition="$([System.String]::Copy('%(RelativePath)').StartsWith('BuildHost-'))" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>
