<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- Add net11.0 for local dev, but excluded from CI via condition below -->
    <TargetFrameworks Condition="'$(CI)' != 'true'">net8.0;net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>RoslynMcp</AssemblyName>
    <LangVersion>preview</LangVersion>

    <!-- Package metadata -->
    <Version>0.2.0-alpha</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <Authors>Quinten Martens</Authors>
    <Description>Model Context Protocol server exposing Roslyn-powered code intelligence tools to AI coding agents</Description>
    <PackageProjectUrl>https://github.com/MadQ/RoslynMcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MadQ/RoslynMcp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>roslyn;mcp;model-context-protocol;ai;code-intelligence</PackageTags>

    <!-- Self-contained so dnx / copilot can run it without a matching SDK on PATH -->
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net8.0|AnyCPU'">
    <NoWarn>1701;1702;NETSDK1209</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0|AnyCPU'">
    <NoWarn>1701;1702;NETSDK1209</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net11.0|AnyCPU'">
    <NoWarn>1701;1702;NETSDK1209</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net8.0|AnyCPU'">
    <NoWarn>1701;1702;NETSDK1209</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0|AnyCPU'">
    <NoWarn>1701;1702;NETSDK1209</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net11.0|AnyCPU'">
    <NoWarn>1701;1702;NETSDK1209</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude the TestHarness sub-project from the SDK glob — it has its own csproj. -->
    <Compile Remove="TestHarness/**" />
    <None Remove="TestHarness/**" />
    <EmbeddedResource Remove="TestHarness/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.1.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.3.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.3.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.7.8" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0-preview.3.25171.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0-preview.3.25171.5" />
  </ItemGroup>

</Project>
