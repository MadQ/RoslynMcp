# Auto detect text files and perform LF normalization
* text=auto

# C# files — explicit CRLF (Windows-native repo)
*.cs text eol=crlf diff=csharp

# Project files
*.csproj text eol=crlf diff=xml
*.slnx text eol=crlf diff=xml
*.sln text eol=crlf diff=xml
*.props text eol=crlf diff=xml
*.targets text eol=crlf diff=xml

# Markdown
*.md text eol=crlf diff=markdown

# JSON
*.json text eol=crlf

# Scripts
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary files
*.dll binary
*.exe binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.woff binary
*.woff2 binary
